# Zoom Server-to-Server OAuth Credentials
# Get these from https://marketplace.zoom.us/develop/apps
# App type: Server-to-Server OAuth

ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Airtable read-only roster access
AIRTABLE_ACCESS_TOKEN=your_airtable_personal_access_token
AIRTABLE_BASE_ID=app_your_airtable_base_id
AIRTABLE_TABLE_NAME=People
AIRTABLE_VIEW_NAME=Engagement Analyzer

# Google Sheets service account
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=engagement-sheets-sync@your-project.iam.gserviceaccount.com
# Keep the literal \n sequences when copying private_key from the JSON file.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# Zone Dashboard User Access Registry (read-only). Share Viewer with the
# Analyzer service account. If unset, sync can use workbook tab
# "Dashboard Access Source" as a paste/export fallback.
USER_ACCESS_SHEET_ID=

# Gmail / mailbox engagement (read-only Workspace domain-wide delegation)
# Authorize scope: https://www.googleapis.com/auth/gmail.readonly
GMAIL_MAILBOXES=info@altagether.org,john@altagether.org,newsletter@altagether.org,issues@altagether.org
GMAIL_DIRECTIONS=inbound
GMAIL_AUTH_MODE=domain_wide
# Optional; defaults to the rolling 12-week scoring window. Sync stores a
# quota-safe backfill cursor in the workbook and refreshes recent mail each run.
# GMAIL_LOOKBACK_DAYS=84
